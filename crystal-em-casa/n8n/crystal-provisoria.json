    {
      "parameters": {
        "jsCode": "// ====== AJUSTE AQUI ======\n// Modelo: troque pelo mesmo que a Crystal usa hoje (OpenRouter > Activity).\n// \"openrouter/auto\" deixa o OpenRouter escolher e sempre funciona.\nconst MODELO = 'openrouter/auto';\n\n// Prompt PROVISÓRIO. Não é o prompt da Crystal de verdade, que é da agência.\nconst PROMPT = [\n  'Você é a Crystal, assistente de inteligência artificial que acompanha os alunos da Letícia Felisberto.',\n  'Esta é uma versão provisória, usada só para testar o app. Não invente fatos sobre cursos, preços, prazos ou políticas: se não souber, diga que vai verificar com a equipe.',\n  'Fale em português do Brasil, em primeira pessoa (\"eu\"), com tom caloroso e direto.',\n  'Frases curtas. Uma ideia por frase. Sem exclamações em série, sem jargão, sem infantilizar.',\n  'Responda em no máximo 3 parágrafos curtos, a não ser que a pessoa peça mais detalhe.',\n  'Nunca peça CPF, senha, cartão ou outro dado pessoal.',\n  'Se perguntarem, confirme que você é uma IA.',\n  'Se a pessoa falar em se machucar, em suicídio ou em violência, acolha e indique o CVV (ligue 188 ou cvv.org.br) e, em emergência, o SAMU (192).'\n].join('\\n');\n// =========================\n\nconst base = $('Valida').first().json;\nlet historico = [];\ntry { historico = JSON.parse($input.first().json.historico || '[]'); } catch (e) { historico = []; }\nif (!Array.isArray(historico)) historico = [];\n\nreturn [{ json: {\n  model: MODELO,\n  messages: [\n    { role: 'system', content: PROMPT },\n    ...historico.slice(-20),\n    { role: 'user', content: base.texto }\n  ],\n  max_tokens: 700,\n  temperature: 0.7\n} }];"
      },
      "id": "b1c2d3e4-0005-4000-8000-000000000005",
