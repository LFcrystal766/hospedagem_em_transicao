          "id": "crystalProvKey01",
          "name": "Crystal provisória · chave do app"
        }
      },
      "notes": "O app chama com o header x-api-key. Contrato: docs/crystal-api.md do crystal-web-chat. Recebe {contact_id, conversation_id, message:{type,text}} e devolve {text}."
    },
    {
      "parameters": {
        "jsCode": "// Confere o que o app mandou. Só o texto e o id da conversa seguem adiante:\n// contact_id e qualquer dado pessoal NÃO vão para o OpenRouter.\nconst corpo = $input.first().json.body ?? {};\nconst texto = typeof corpo?.message?.text === 'string' ? corpo.message.text.trim() : '';\nconst conversa = (typeof corpo.conversation_id === 'string' || typeof corpo.conversation_id === 'number')\n  ? String(corpo.conversation_id) : '';\nconst ok = texto.length > 0 && texto.length <= 4000 && /^[A-Za-z0-9_-]{1,100}$/.test(conversa);\nreturn [{ json: { ok, texto, conversa, chave: `crystal:provisoria:${conversa}` } }];"
      },
      "id": "b1c2d3e4-0002-4000-8000-000000000002",
      "name": "Valida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
