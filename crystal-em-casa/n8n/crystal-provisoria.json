    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst c = r?.choices?.[0]?.message?.content;\nconst texto = typeof c === 'string' ? c.trim() : '';\nconst base = $('Valida').first().json;\nlet historico = [];\ntry { historico = JSON.parse($('Lê histórico').first().json.historico || '[]'); } catch (e) { historico = []; }\nif (!Array.isArray(historico)) historico = [];\nconst novo = [...historico, { role: 'user', content: base.texto }, { role: 'assistant', content: texto }].slice(-20);\nreturn [{ json: { ok: texto.length > 0, text: texto, chave: base.chave, historico: JSON.stringify(novo) } }];"
      },
