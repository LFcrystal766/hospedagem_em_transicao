    {
      "parameters": {
        "jsCode": "// Segurança 24/10 (INT-06, INT-08, INT-17): confere o corpo da Assiny e deixa passar só o que os próximos nós usam.\n// Sem módulo externo e sem variável de ambiente (os dois estão travados na VPS). Um item entra, um item sai.\n// - evento:   o que vai ao Supabase (e-mail, nome, telefone, transação, oferta); sem CPF, endereço, metadata, comissões.\n// - para_api: o que vai à API do app no reembolso e no pacote de imagens (e-mail, CPF só com 11 dígitos, transação com\n//             as datas, oferta): é o formato que a API valida (assinyRefundEventSchema), com a data do evento incluída.\n// - saudacao: só o primeiro nome, só letras, até 60 caracteres; o e-mail nunca entra no texto do e-mail.\nconst corpo = $input.first().json.body;\nconst campos = [];\nconst obj = (v) => (v && typeof v === 'object' && !Array.isArray(v) ? v : null);\nconst texto = (v, max) => (typeof v === 'string' && v.trim() !== '' ? v.trim().slice(0, max) : null);\nconst id = (v) => (typeof v === 'string' && /^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$/.test(v.trim()) ? v.trim() : null);\nconst data = (v) => (typeof v === 'string' && v.length <= 64 && !Number.isNaN(Date.parse(v)) ? v : null);\nconst limpar = (o) => {\n  if (!o || typeof o !== 'object') return o;\n  const r = {};\n  for (const [k, v] of Object.entries(o)) {\n    if (v === null || v === undefined) continue;\n    const l = typeof v === 'object' ? limpar(v) : v;\n    if (l !== null && l !== undefined && !(typeof l === 'object' && Object.keys(l).length === 0)) r[k] = l;\n  }\n  return r;\n};\n\nconst raiz = obj(corpo);\nif (!raiz) campos.push('(raiz)');\nconst event = raiz && typeof raiz.event === 'string' && /^[a-z][a-z0-9_.:-]{1,63}$/.test(raiz.event) ? raiz.event : null;\nif (!event) campos.push('event');\nconst d = raiz ? obj(raiz.data) : null;\nconst cliente = d ? obj(d.client) : null;\nconst tx = d ? obj(d.transaction) : null;\nconst oferta = d ? obj(d.offer) : null;\nconst produto = oferta ? obj(oferta.product) : null;\nconst assinatura = oferta ? obj(oferta.subscription) : null;\n\nconst LIBERAM = ['approved_purchase', 'purchase_approved', 'subscription_renewed', 'renewed_subscription'];\nconst BLOQUEIAM = ['refunded_purchase', 'chargeback', 'charged_back', 'chargedback_purchase', 'canceled_subscription', 'subscription_canceled'];\nconst conhecido = LIBERAM.includes(event) || BLOQUEIAM.includes(event);\n\nconst email = cliente && typeof cliente.email === 'string' && cliente.email.trim().length <= 200\n  && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(cliente.email.trim()) ? cliente.email.trim().toLowerCase() : null;\nconst txId = tx ? id(tx.id) : null;\nconst txStatus = tx ? texto(tx.status, 64) : null;\nif (conhecido) {\n  // Compra ou reembolso: o mínimo coerente é obrigatório. Outros eventos (pix gerado, carrinho) só precisam do nome.\n  if (!d) campos.push('data');\n  if (!email) campos.push('data.client.email');\n  if (!txId) campos.push('data.transaction.id');\n  if (!txStatus) campos.push('data.transaction.status');\n  if (produto && !id(produto.id)) campos.push('data.offer.product.id');\n  if (assinatura && assinatura.id != null && !id(assinatura.id)) campos.push('data.offer.subscription.id');\n}\nif (campos.length) {\n  return [{ json: { ok: false, motivo: 'corpo_invalido', campos }, pairedItem: { item: 0 } }];\n}\n\nconst documento = cliente && typeof cliente.document === 'string' ? cliente.document.replace(/\\D/g, '') : '';\nconst primeiro = cliente && typeof cliente.first_name === 'string' ? cliente.first_name.trim() : '';\nconst saudacao = /^[A-Za-zÀ-ÖØ-öø-ÿ][A-Za-zÀ-ÖØ-öø-ÿ' -]{0,59}$/.test(primeiro) ? 'Olá, ' + primeiro + '!' : 'Olá!';\nconst transacao = tx ? { id: txId, status: txStatus, created_at: data(tx.created_at), updated_at: data(tx.updated_at) } : null;\nconst ofertaEnxuta = oferta ? {\n  id: id(oferta.id), name: texto(oferta.name, 120),\n  product: produto ? { id: id(produto.id), name: texto(produto.name, 120) } : null,\n  subscription: assinatura ? { id: id(assinatura.id) } : null,\n} : null;\nconst evento = limpar({ event, data: { client: { email, full_name: cliente ? texto(cliente.full_name, 120) : null, phone: cliente ? texto(cliente.phone, 32) : null }, transaction: transacao, offer: ofertaEnxuta } });\nconst paraApi = limpar({ event, data: { client: { id: cliente ? id(cliente.id) : null, email, document: documento.length === 11 ? documento : null }, transaction: transacao, offer: ofertaEnxuta } });\nreturn [{ json: { ok: true, event, email, transacao: txId, saudacao, evento, para_api: paraApi }, pairedItem: { item: 0 } }];\n"
      },
