    {
      "parameters": {
        "jsCode": "// Valida e normaliza o que chegou. Enquanto a agência não mandar o formato\n// definitivo, o mínimo exigido é um objeto JSON. Tudo o que vier é guardado\n// inteiro em `bruto`, para não perder nada quando o formato for definido.\nconst entrada = $input.first().json;\nconst corpo = entrada.body ?? {};\nconst headers = entrada.headers ?? {};\n\nconst ehObjeto = corpo && typeof corpo === 'object' && !Array.isArray(corpo);\nconst id = (ehObjeto && (corpo.id || corpo.event_id || corpo.message_id)) || `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;\n\nreturn [{\n  json: {\n    ok: ehObjeto,\n    erro: ehObjeto ? null : 'o corpo precisa ser um objeto JSON',\n    id: String(id),\n    recebido_em: new Date().toISOString(),\n    origem_ip: headers['cf-connecting-ip'] || headers['x-forwarded-for'] || headers['x-real-ip'] || null,\n    user_agent: headers['user-agent'] || null,\n    tipo: (ehObjeto && (corpo.type || corpo.event || corpo.tipo)) || null,\n    bruto: corpo,\n  },\n}];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Valida e normaliza",
      "type": "n8n-nodes-base.code",
